[Unit]
Description=Keyport Key Release Service
After=mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=keyport
Group=keyport
WorkingDirectory=/opt/keyport/app
EnvironmentFile=/opt/keyport/keyport.conf

ExecStart=/opt/keyport/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --no-control-socket \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=on-failure
RestartSec=5

NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

RemoveIPC=true
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid

RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true

CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadWritePaths=/var/lib/keyport
UMask=0077

[Install]
WantedBy=multi-user.target
