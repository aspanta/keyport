#!/bin/bash

set -euo pipefail

# Informational options must precede root checks, locks, and network access.
case "$#:$*" in
    0:) ;;
    1:-h|1:--help)
        cat <<'HELP'
usage: keyport-update [-h] [-v]

Update the installed keyport from main.

options:
  -h, --help     show this help message and exit
  -v, --version  show version information and exit
HELP
        exit 0
        ;;
    1:-v|1:--version)
        python3 - "/opt/keyport/app/build-info.json" <<'PY_VERSION'
import json, re, sys
from pathlib import Path
try:
    info = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    version, commit = info["version"], info["commit"]
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?", version) or not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise ValueError("invalid metadata")
except (OSError, ValueError, TypeError, KeyError, UnicodeError):
    version, commit = "unknown", "unknown"
print(f"keyport-update {version} ({commit[:12]})")
PY_VERSION
        exit $?
        ;;
    *) echo "keyport-update: unknown arguments; use --help" >&2; exit 2 ;;
esac

REPO="aspanta/keyport"
BRANCH="main"

INSTALL_DIR="/opt/keyport"
UPDATE_LOCK_HELD=0
APP_DIR="${INSTALL_DIR}/app"
BIN_DIR="${INSTALL_DIR}/bin"
CONFIG_FILE="${INSTALL_DIR}/keyport.conf"

SERVICE="keyport.service"
HEALTH_URL="http://127.0.0.1:8000/health"
READY_URL="http://127.0.0.1:8000/ready"
UPDATE_STARTED=0
UPDATE_COMMITTED=0

die() {
    echo "keyport update: $*" >&2
    exit 1
}

info() {
    echo "keyport update: $*"
}

cleanup() {
    if [[ -n "${TMPDIR_KEYPORT:-}" && -d "${TMPDIR_KEYPORT}" ]]; then
        rm -rf "${TMPDIR_KEYPORT}"
    fi
    # Last filesystem action: both locks remain held until process exit.
    # The directory lock prevents a new updater from opening another lock
    # inode between this unlink and exit. Never remove another owner's file.
    if [[ "${UPDATE_LOCK_HELD}" -eq 1 ]]; then
        rm -f "${INSTALL_DIR}/.update.lock"
    fi
}

finish() {
    local status=$?
    trap - EXIT
    trap '' INT TERM
    if [[ "${UPDATE_STARTED}" -eq 1 && "${UPDATE_COMMITTED}" -eq 0 ]]; then
        rollback_application || info "WARNING: rollback incomplete; preserve .app.old and .bin.old for recovery"
        status=1
    fi
    cleanup
    exit "${status}"
}

trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

#
# Preconditions
#

if [[ "${EUID}" -ne 0 ]]; then
    die "must be run as root"
fi

for command in curl tar python3 sha256sum systemctl mariadb flock; do
    command -v "${command}" >/dev/null 2>&1 \
        || die "required command not found: ${command}"
done

[[ -d "${INSTALL_DIR}" ]] \
    || die "Keyport is not installed in ${INSTALL_DIR}"

# Lock the stable installation directory before opening the removable file.
# Retain the file lock too, to coordinate with previously installed updaters.
exec 9<"${INSTALL_DIR}"
flock -n 9 || die "another update is already running"
exec 8>"${INSTALL_DIR}/.update.lock"
flock -n 8 || die "another update is already running"
UPDATE_LOCK_HELD=1

APP_NEW="${INSTALL_DIR}/.app.new"
BIN_NEW="${INSTALL_DIR}/.bin.new"
APP_OLD="${INSTALL_DIR}/.app.old"
BIN_OLD="${INSTALL_DIR}/.bin.old"

# A previous interrupted deployment may still need these recovery copies.
for backup in "${APP_OLD}" "${BIN_OLD}"; do
    [[ ! -e "${backup}" ]] || die "recovery required: backup exists at ${backup}"
done

[[ -d "${APP_DIR}" ]] \
    || die "application directory not found: ${APP_DIR}"

[[ -d "${BIN_DIR}" ]] \
    || die "binary directory not found: ${BIN_DIR}"

[[ -r "${CONFIG_FILE}" ]] \
    || die "configuration not readable: ${CONFIG_FILE}"

systemctl cat "${SERVICE}" >/dev/null 2>&1 \
    || die "systemd service not found: ${SERVICE}"

#
# Read database configuration.
#

read_config_value() {
    local name="$1"
    local line

    line="$(grep -m1 "^${name}=" "${CONFIG_FILE}")" \
        || return 1

    printf '%s' "${line#*=}"
}

DB_SOCKET="$(read_config_value DB_SOCKET)" \
    || die "DB_SOCKET is missing from ${CONFIG_FILE}"

DB_NAME="$(read_config_value DB_NAME)" \
    || die "DB_NAME is missing from ${CONFIG_FILE}"

DB_USER="$(read_config_value DB_USER)" \
    || die "DB_USER is missing from ${CONFIG_FILE}"

DB_PASSWORD="$(read_config_value DB_PASSWORD)" \
    || die "DB_PASSWORD is missing from ${CONFIG_FILE}"

[[ "${DB_NAME}" =~ ^[A-Za-z0-9_]+$ ]] \
    || die "DB_NAME contains unsupported characters"

#
# Temporary workspace.
#

TMPDIR_KEYPORT="$(mktemp -d)"

ARCHIVE="${TMPDIR_KEYPORT}/keyport.tar.gz"
SOURCE_DIR="${TMPDIR_KEYPORT}/source"

mkdir -p "${SOURCE_DIR}"

#
# Download current main snapshot.
#

info "resolving ${REPO} ${BRANCH}"

COMMIT="$(curl -fsSL -H 'User-Agent: Keyport' "https://api.github.com/repos/${REPO}/commits/${BRANCH}" |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])')" \
    || die "cannot resolve main to a commit"
[[ "${COMMIT}" =~ ^[0-9a-f]{40}$ ]] || die "invalid commit returned by GitHub"

ARCHIVE_URL="https://github.com/${REPO}/archive/${COMMIT}.tar.gz"
info "downloading ${REPO} ${COMMIT}"

curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --output "${ARCHIVE}" \
    "${ARCHIVE_URL}" \
    || die "failed to download repository archive"

tar \
    --extract \
    --gzip \
    --file "${ARCHIVE}" \
    --directory "${SOURCE_DIR}" \
    --strip-components=1 \
    || die "failed to extract repository archive"

SERVER_SOURCE="${SOURCE_DIR}/server"
APP_SOURCE="${SERVER_SOURCE}/app"
BIN_SOURCE="${SERVER_SOURCE}/bin"
MIGRATIONS_SOURCE="${SERVER_SOURCE}/sql/migrations"
UPDATE_SOURCE="${BIN_SOURCE}/keyport-update"

[[ -d "${APP_SOURCE}" ]] \
    || die "downloaded repository does not contain server/app"

[[ -d "${BIN_SOURCE}" ]] \
    || die "downloaded repository does not contain server/bin"

[[ -f "${UPDATE_SOURCE}" ]] \
    || die "downloaded repository does not contain server/bin/keyport-update"

#
# Validate downloaded code.
#

info "validating downloaded files"

while IFS= read -r -d '' file; do
    python3 -m py_compile "${file}" \
        || die "Python validation failed: ${file#${SOURCE_DIR}/}"
done < <(
    find "${APP_SOURCE}" "${BIN_SOURCE}" \
        -type f \
        -name '*.py' \
        -print0
)

if [[ -f "${APP_SOURCE}/app.py" ]]; then
    python3 -m py_compile "${APP_SOURCE}/app.py" \
        || die "application validation failed"
fi

if [[ -f "${BIN_SOURCE}/keyport" ]]; then
    python3 -m py_compile "${BIN_SOURCE}/keyport" \
        || die "administration CLI validation failed"
fi

bash -n "${UPDATE_SOURCE}" \
    || die "update script validation failed"

#
# Prepare MariaDB client configuration.
#
# The password is kept out of process arguments.
#

MYSQL_CNF="${TMPDIR_KEYPORT}/mysql.cnf"

cat > "${MYSQL_CNF}" <<MYSQL_EOF
[client]
user=${DB_USER}
password=${DB_PASSWORD}
socket=${DB_SOCKET}
database=${DB_NAME}
MYSQL_EOF

chmod 0600 "${MYSQL_CNF}"

mysql_exec() {
    mariadb \
        --defaults-extra-file="${MYSQL_CNF}" \
        --batch \
        --skip-column-names \
        "$@"
}

#
# Verify database connectivity before changing anything.
#

info "checking database connection"

mysql_exec --execute="SELECT 1;" >/dev/null \
    || die "cannot connect to Keyport database"

#
# Bootstrap migration tracking.
#

info "checking migration infrastructure"

mysql_exec <<'SQL'
CREATE TABLE IF NOT EXISTS schema_migrations (
    version     VARCHAR(255) NOT NULL,
    checksum    CHAR(64) NOT NULL,
    applied_at  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (version)
) ENGINE=InnoDB
  DEFAULT CHARSET=ascii
  COLLATE=ascii_bin;
SQL

#
# Validate migrations and build the pending migration list.
#

PENDING_FILE="${TMPDIR_KEYPORT}/pending-migrations"
: > "${PENDING_FILE}"

if [[ -d "${MIGRATIONS_SOURCE}" ]]; then
    while IFS= read -r migration; do
        filename="$(basename "${migration}")"

        if [[ ! "${filename}" =~ ^[0-9]{3}-[a-z0-9][a-z0-9-]*\.sql$ ]]; then
            die "invalid migration filename: ${filename}"
        fi

        checksum="$(sha256sum "${migration}" | awk '{print $1}')"

        version_hex="$(
            printf '%s' "${filename}" |
            od -An -tx1 |
            tr -d ' \n'
        )"

        stored_checksum="$(
            mysql_exec \
                --execute="
                    SELECT checksum
                    FROM schema_migrations
                    WHERE version = CONVERT(0x${version_hex} USING ascii);
                "
        )"

        if [[ -n "${stored_checksum}" ]]; then
            if [[ "${stored_checksum}" != "${checksum}" ]]; then
                die "migration checksum mismatch: ${filename}"
            fi

            continue
        fi

        printf '%s\n' "${migration}" >> "${PENDING_FILE}"

    done < <(
        find "${MIGRATIONS_SOURCE}" \
            -maxdepth 1 \
            -type f \
            -name '*.sql' \
            -print |
        LC_ALL=C sort
    )
fi

# Metadata belongs to the downloaded revision and rolls back with app/.
VERSION_SOURCE="${SOURCE_DIR}/VERSION"
BUILD_SOURCE="${APP_SOURCE}/build-info.json"

python3 - "${VERSION_SOURCE}" "${COMMIT}" "${BUILD_SOURCE}" <<'PY_BUILD'
import json, re, sys
from pathlib import Path
version = Path(sys.argv[1]).read_text(encoding="ascii").strip()
if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?", version):
    raise SystemExit("invalid VERSION")
Path(sys.argv[3]).write_text(json.dumps({"version": version, "commit": sys.argv[2]}) + "\n", encoding="utf-8")
PY_BUILD
SOURCE_VERSION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "${BUILD_SOURCE}")"

#
# Stage complete app/bin trees.
#

STAGED_APP="${TMPDIR_KEYPORT}/app"
STAGED_BIN="${TMPDIR_KEYPORT}/bin"

cp -a "${APP_SOURCE}" "${STAGED_APP}"
cp -a "${BIN_SOURCE}" "${STAGED_BIN}"

#
# Apply pending migrations.
#
# Migrations must be safe to run once and must remain compatible with
# the previously deployed application. MariaDB DDL may perform implicit
# commits, so migrations are not automatically rolled back.
#

if [[ -s "${PENDING_FILE}" ]]; then
    while IFS= read -r migration; do
        filename="$(basename "${migration}")"
        checksum="$(sha256sum "${migration}" | awk '{print $1}')"

        version_hex="$(
            printf '%s' "${filename}" |
            od -An -tx1 |
            tr -d ' \n'
        )"

        info "applying migration ${filename}"

        mysql_exec < "${migration}" \
            || die "migration failed: ${filename}"

        mysql_exec \
            --execute="
                INSERT INTO schema_migrations (version, checksum)
                VALUES (
                    CONVERT(0x${version_hex} USING ascii),
                    '${checksum}'
                );
            " \
            || die "migration applied but could not be recorded: ${filename}"

    done < "${PENDING_FILE}"
else
    info "no pending migrations"
fi

#
# Prepare new production trees on the same filesystem as the
# installed application.
#

rm -rf "${APP_NEW}" "${BIN_NEW}"

cp -a "${STAGED_APP}" "${APP_NEW}"
cp -a "${STAGED_BIN}" "${BIN_NEW}"

#
# Apply production ownership and permissions.
#

chown -R root:keyport "${APP_NEW}" "${BIN_NEW}"

find "${APP_NEW}" \
    -type d \
    -exec chmod 0750 {} +

find "${APP_NEW}" \
    -type f \
    -exec chmod 0640 {} +

find "${BIN_NEW}" \
    -type d \
    -exec chmod 0750 {} +

find "${BIN_NEW}" \
    -type f \
    -exec chmod 0755 {} +

#
# Rollback helper.
#

wait_for_endpoint() {
    local url="$1" expected_commit="${2:-}" expected_version="${3:-}" attempt body
    for attempt in 1 2 3 4 5; do
        if body="$(curl --fail --silent --max-time 5 "${url}")"; then
            if [[ -z "${expected_commit}" ]]; then
                return 0
            fi
            if python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("status")=="ready" and d.get("commit")==sys.argv[1] and d.get("version")==sys.argv[2] else 1)' "${expected_commit}" "${expected_version}" <<< "${body}"; then
                return 0
            fi
        fi
        sleep 1
    done
    return 1
}

rollback_application() {
    info "rolling back application files"
    local failed=0 old destination

    if ! systemctl stop "${SERVICE}"; then
        info "WARNING: cannot stop service; recovery copies retained"
        return 1
    fi

    # A rename may have succeeded just before a signal arrived. Inspect the
    # backups themselves rather than flags set after each rename. Never remove
    # a production tree whose original was not backed up.
    for old in "${APP_OLD}" "${BIN_OLD}"; do
        if [[ -d "${old}" ]]; then
            if [[ "${old}" == "${APP_OLD}" ]]; then
                destination="${APP_DIR}"
            else
                destination="${BIN_DIR}"
            fi
            if ! rm -rf "${destination}" || ! cp -a "${old}" "${destination}"; then
                info "WARNING: cannot restore ${destination}; backup retained at ${old}"
                failed=1
            fi
        fi
    done

    if [[ "${failed}" -ne 0 ]]; then
        return 1
    fi
    if ! systemctl start "${SERVICE}" || ! systemctl is-active --quiet "${SERVICE}"; then
        info "WARNING: previous files restored but service failed to start; backups retained"
        return 1
    fi

    # The previous release may predate /ready. Retain recovery copies until
    # its process has actually begun serving requests.
    if ! wait_for_endpoint "${HEALTH_URL}"; then
        info "WARNING: previous application failed health check; backups retained"
        return 1
    fi
    rm -rf "${APP_OLD}" "${BIN_OLD}" || return 1
    info "previous application restored and started"
}

#
# Switch app/bin trees.
#

info "deploying application"

UPDATE_STARTED=1
systemctl stop "${SERVICE}"

mv "${APP_DIR}" "${APP_OLD}"
mv "${BIN_DIR}" "${BIN_OLD}"

mv "${APP_NEW}" "${APP_DIR}"
mv "${BIN_NEW}" "${BIN_DIR}"

#
# Restart new application.
#

info "restarting ${SERVICE}"

if ! systemctl restart "${SERVICE}"; then
    die "update failed during service restart"
fi

if ! systemctl is-active --quiet "${SERVICE}"; then
    die "updated service is not active"
fi

#
# Readiness check.
#

info "checking application readiness"

if ! wait_for_endpoint "${READY_URL}" "${COMMIT}" "${SOURCE_VERSION}"; then
    die "updated application failed readiness check"
fi

#
# New application is healthy. The updater is part of the deployed bin tree.
#

ln -sfn "${INSTALL_DIR}/bin/keyport" /usr/local/sbin/keyport
ln -sfn "${INSTALL_DIR}/bin/keyport-update" /usr/local/sbin/keyport-update

#
# Deployment succeeded. Old application trees are no longer needed.
#

# After this point the new deployment is accepted. Cleanup failure must not
# trigger a rollback after one of the backups has already been removed.
UPDATE_COMMITTED=1
rm -rf "${APP_OLD}" "${BIN_OLD}"

info "update complete"
